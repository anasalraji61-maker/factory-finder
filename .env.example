# Copy to .env — NEVER commit real values (this repo is public).
# Generate: python -c 'import secrets;print(secrets.token_urlsafe(48))'
FF_GATEWAY_JWT_SECRET=
# Shared gateway->service token; set it in production (backend ports are not published by compose)
FF_INTERNAL_TOKEN=
# JSON list; empty = no cross-origin access (default). Dev web: ["http://localhost:3000"]
FF_GATEWAY_CORS_ORIGINS=[]
# Enables /v1/admin/* on the gateway (unset -> 404). Use a long random value.
FF_GATEWAY_ADMIN_TOKEN=
# Rate limits shared across replicas: redis://host:6379/0 (needs `pip install ff-gateway[redis]`); empty = in-memory
FF_GATEWAY_REDIS_URL=
# Email verification: mail backend off (default) | mock | smtp; gate payments/supplier claims/listings when true
FF_GATEWAY_MAIL_BACKEND=
FF_GATEWAY_REQUIRE_EMAIL_VERIFIED=
FF_GATEWAY_MAIL_FROM=
FF_GATEWAY_SMTP_HOST=
FF_GATEWAY_SMTP_PORT=
FF_GATEWAY_SMTP_USER=
FF_GATEWAY_SMTP_PASSWORD=
FF_GATEWAY_VERIFY_URL_TEMPLATE=          # e.g. https://app.example.com/verify?token={token}
# Optional real provider keys (all adapters are OFF by default)
FF_SOURCING_ALIBABA_APP_KEY=
FF_SOURCING_ALIBABA_APP_SECRET=
FF_LOGISTICS_FX_PROVIDER=mock   # mock | ecb
# Phase 4 real adapters: OFF by default, UNVERIFIED against live APIs. Empty = disabled.
FF_SOURCING_ADAPTERS=                    # e.g. alibaba_openapi (mock stays the fallback)
FF_SOURCING_ALIBABA_ACCESS_TOKEN=
FF_SOURCING_ALIBABA_OPENAPI_DISABLED=    # 1 = kill-switch for this adapter
FF_SOURCING_KILL_SWITCH=                 # 1 = disable every real sourcing adapter
FF_LOGISTICS_FREIGHT_PROVIDER=mock       # mock | http
FF_LOGISTICS_FREIGHT_URL=
FF_LOGISTICS_FREIGHT_API_KEY=
FF_LOGISTICS_FREIGHT_DISABLED=           # 1 = kill-switch for live freight rates
FF_LOGISTICS_KILL_SWITCH=
# Assistant LLM (optional, OFF by default; only for low-confidence parsing + optional tone rewrite)
FF_ASSISTANT_LLM=                        # empty/off | mock | anthropic
FF_ASSISTANT_LLM_API_KEY=
FF_ASSISTANT_LLM_MODEL=
FF_ASSISTANT_LLM_BASE_URL=
FF_ASSISTANT_LLM_REWRITE=                # true = tone-rewrite answers (numbers verified)

# --- Databases (rfq, messaging, tracking, notifications, demand) -----------------------------
# Empty = SQLite file in the service dir (dev). For PostgreSQL use postgresql://user:pass@host:5432/db
# (rewritten to postgresql+asyncpg://; install the `pg` extra). One database per service.
FF_RFQ_DATABASE_URL=
FF_MESSAGING_DATABASE_URL=
FF_TRACKING_DATABASE_URL=
FF_NOTIFICATIONS_DATABASE_URL=
FF_DEMAND_DATABASE_URL=
# Create tables on startup: empty = true for SQLite, false for PostgreSQL (use `alembic upgrade head`)
FF_RFQ_DB_AUTO_CREATE=
FF_MESSAGING_DB_AUTO_CREATE=
FF_TRACKING_DB_AUTO_CREATE=
FF_NOTIFICATIONS_DB_AUTO_CREATE=
FF_DEMAND_DB_AUTO_CREATE=
# Compose profile `pg` only
FF_POSTGRES_PASSWORD=
FF_DOCKER_EXTRAS=                        # set to `pg` when using PostgreSQL
# Demand matching (OFF by default; human-in-the-loop, see CLAUDE.md rule 7)
FF_DEMAND_ENABLED=false
FF_DEMAND_DAILY_CAP=20
# Notification delivery (all OFF by default; credentials ONLY here / in the environment)
FF_NOTIFY_PUSH=                          # off|mock|fcm
FF_NOTIFY_FCM_PROJECT_ID=
FF_NOTIFY_FCM_CREDENTIALS_FILE=          # path to a service-account JSON (or use _JSON)
FF_NOTIFY_FCM_CREDENTIALS_JSON=
FF_NOTIFY_EMAIL=                         # off|mock|smtp (daily digest)
FF_NOTIFY_SMTP_HOST=
FF_NOTIFY_SMTP_PORT=
FF_NOTIFY_SMTP_USER=
FF_NOTIFY_SMTP_PASSWORD=
FF_NOTIFY_SMTP_FROM=
# Payments (provider OFF unless mock/usdt_tron; secrets ONLY here / in the environment; see services/payments/README.md)
FF_PAYMENTS_PROVIDER=mock                # mock|usdt_tron|off
# Also read by the gateway (injected towards /v1/payments/outbox* for /v1/admin/payments/outbox*; unset there -> 404)
FF_PAYMENTS_ADMIN_TOKEN=
FF_PAYMENTS_WEBHOOK_SECRET_MOCK=
FF_PAYMENTS_WEBHOOK_SECRET_USDT_TRON=
FF_PAYMENTS_USDT_RECEIVE_ADDRESS=        # PUBLIC address of the owner's own wallet (never a private key)
FF_PAYMENTS_USDT_CONTRACT=
FF_PAYMENTS_USDT_EXPLORER_URL=
FF_PAYMENTS_USDT_EXPLORER_API_KEY=
# Media (image upload; see services/media/README.md). Public GET /v1/media/files/<id>.<ext> is served through the gateway.
FF_MEDIA_PUBLIC_BASE_URL=                # PUBLIC gateway origin, e.g. https://api.example.com -> absolute image URLs
FF_MEDIA_STORAGE_BACKEND=local           # local|s3 (s3 is UNVERIFIED)
FF_MEDIA_STORAGE_ROOT=
FF_MEDIA_MAX_UPLOAD_BYTES=
FF_MEDIA_S3_BUCKET=
FF_MEDIA_S3_REGION=
FF_MEDIA_S3_ENDPOINT_URL=
FF_MEDIA_S3_ACCESS_KEY_ID=
FF_MEDIA_S3_SECRET_ACCESS_KEY=
# Tracking real providers (OFF unless FF_TRACKING_PROVIDER=http; licensed APIs only; see services/tracking/README.md)
FF_TRACKING_PROVIDER=                    # empty/mock (default) | http
FF_TRACKING_CONTAINER_BASE_URL=
FF_TRACKING_CONTAINER_API_KEY=
FF_TRACKING_AWB_BASE_URL=
FF_TRACKING_AWB_API_KEY=
FF_TRACKING_VESSEL_BASE_URL=             # AIS provider, official API only
FF_TRACKING_VESSEL_API_KEY=
FF_TRACKING_HTTP_MIN_INTERVAL_SECONDS=   # per host, floor 3
FF_TRACKING_FALLBACK_TO_MOCK=            # empty = true: on provider failure answer mock data + `warning`
FF_TRACKING_KILL_SWITCH=                 # 1 = disable every real tracking provider (also *_CONTAINER_DISABLED / _AWB_DISABLED / _VESSEL_DISABLED)
FF_TRACKING_REFRESH_JOB_ENABLED=         # true = background refresh of active shipments
FF_TRACKING_REFRESH_JOB_INTERVAL_HOURS=
