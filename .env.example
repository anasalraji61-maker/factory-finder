# Copy to .env — NEVER commit real values (this repo is public).
# Generate: python -c 'import secrets;print(secrets.token_urlsafe(48))'
FF_GATEWAY_JWT_SECRET=
# Shared gateway->service token; set it in production (backend ports are not published by compose)
FF_INTERNAL_TOKEN=
# JSON list; restrict in production, e.g. ["https://app.example.com"]
FF_GATEWAY_CORS_ORIGINS=["*"]
# Optional real provider keys (all adapters are OFF by default)
FF_SOURCING_ALIBABA_APP_KEY=
FF_SOURCING_ALIBABA_APP_SECRET=
FF_LOGISTICS_FX_PROVIDER=mock   # mock | ecb
