{
  "_comment": "EXAMPLE ONLY - FICTIONAL PROVIDER 'Examplia Trade Data'. Copy, rename, edit every field to match your licensed provider's documentation. Never put a key here.",
  "schema_version": 1,
  "id": "examplia_trade",
  "name": "EXAMPLE (fictional) Examplia Trade Data",
  "example": true,
  "tos_note": "EXAMPLE: replace with the licence/agreement reference that permits this use.",
  "robots_note": "Official JSON API under licence; robots.txt applies to web pages, none are fetched.",
  "base_url": "https://api.examplia.invalid",
  "kill_switch_env": "FF_SOURCING_EXAMPLIA_DISABLED",
  "auth": { "style": "bearer", "key_env": "FF_SOURCING_EXAMPLIA_API_KEY" },
  "request": { "method": "GET", "path": "/v2/products/search", "query": { "q": "{keywords}", "ship_from": "{country}" } },
  "pagination": { "style": "page", "page_param": "page", "size_param": "per_page", "page_size": 40, "max_pages": 1 },
  "items_path": "data.items",
  "fields": {
    "id": "product_id",
    "title": "name",
    "price_min": "pricing.min",
    "price_max": "pricing.max",
    "currency": "pricing.currency",
    "supplier_id": "seller.id",
    "supplier_name": "seller.name",
    "country": "seller.country",
    "city": "seller.city",
    "url": "links.detail",
    "images": "photos",
    "moq": "min_order",
    "unit": "uom",
    "verified": "seller.verified",
    "description": "summary",
    "category": "category"
  },
  "defaults": { "currency": "USD", "country": "CN" },
  "currency": { "allowed": ["USD", "EUR", "CNY"], "aliases": { "RMB": "CNY" } },
  "units": { "aliases": { "pcs": "piece", "mt": "ton" }, "price_scale": "1" },
  "images": { "allowed_hosts": ["img.examplia.invalid", ".cdn.examplia.invalid"], "https_only": true, "max": 6 },
  "limits": { "timeout_s": 8, "min_interval_s": 3, "cache_ttl_s": 600 },
  "quality": { "min_price": "0.01", "max_price": "1000000", "max_ratio": "200", "dedupe_threshold": 0.9 }
}
