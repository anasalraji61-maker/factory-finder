# Pinned to a minor + distro (no floating "slim"). For fully reproducible builds pin the digest too:
#   FROM python:3.12-slim-bookworm@sha256:<digest>   (see docs/fixes/supply-chain-review-2026-10.md)
FROM python:3.12-slim-bookworm
ARG SERVICE
ARG EXTRAS=""
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 PIP_NO_CACHE_DIR=1 PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PYTHONPATH=/app/src SERVICE=${SERVICE}
WORKDIR /app
COPY scripts/install_service.py /tmp/install_service.py
COPY services/${SERVICE}/ /app/
RUN python /tmp/install_service.py /app --deps-only --best-effort ${EXTRAS:+--extras $EXTRAS} \
    && rm -f /tmp/install_service.py
# Fixed non-root uid/gid, no login shell, no home dir contents; nothing secret is copied or baked (env only at runtime).
RUN groupadd --system --gid 10001 app \
    && useradd --system --uid 10001 --gid app --no-create-home --shell /usr/sbin/nologin app \
    && chown -R app:app /app
USER app
# --no-server-header: hide "Server: uvicorn". --timeout-keep-alive 5: drop idle keep-alive sockets quickly.
# --no-proxy-headers: deliberate; the gateway resolves X-Forwarded-For itself (FF_GATEWAY_TRUSTED_PROXIES) and
# internal services only ever see the gateway, so uvicorn must not rewrite client addresses.
# `exec` makes uvicorn the direct child of the init process so SIGTERM gives a graceful shutdown.
CMD ["sh", "-c", "exec uvicorn ff_${SERVICE}.main:app --host 0.0.0.0 --port ${PORT:-8000} --no-server-header --timeout-keep-alive 5 --no-proxy-headers"]
