FROM python:3.12-slim
ARG SERVICE
ENV PYTHONUNBUFFERED=1 PYTHONPATH=/app/src SERVICE=${SERVICE}
WORKDIR /app
COPY scripts/install_service.py /tmp/install_service.py
COPY services/${SERVICE}/ /app/
RUN python /tmp/install_service.py /app --deps-only --best-effort
RUN useradd -m app && chown -R app /app
USER app
CMD ["sh", "-c", "uvicorn ff_${SERVICE}.main:app --host 0.0.0.0 --port ${PORT:-8000}"]
